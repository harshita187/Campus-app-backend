# Copy this file to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb://127.0.0.1:27017/campus_bazar
JWT_SECRET=change-me-to-a-long-random-string
PORT=5001
CLIENT_URL=http://localhost:3000
# Extra allowed frontend origins, comma-separated:
# CLIENT_URLS=https://your-frontend.example.com
COOKIE_SECURE=false
# Set to "development" to include stack traces in error responses (never in production):
# NODE_ENV=development
